rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Reglas para los datos privados de cada usuario
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 2. Reglas para los códigos de transferencia (Compartir con amigos)
    match /transfer_codes/{code} {
      // Solo se puede crear si estás logueado, quedas registrado como creador,
      // y el payload no rebasa el límite (forzado en servidor, no solo en Kotlin)
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.data is string
                    && request.resource.data.data.size() < 2000000;

      // Leer y borrar siguen abiertos a cualquier logueado (así funciona compartir código),
      // pero ahora el código es imposible de adivinar por fuerza bruta (10 chars alfanuméricos)
      allow read, delete: if request.auth != null;

      // No existe "update": ningún flujo de la app modifica un código ya creado
    }
  }
}