rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Reglas para los datos privados de cada usuario
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 2. Reglas para los códigos de transferencia (Compartir con amigos)
    match /transfer_codes/{code} {
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.data is string
                    && request.resource.data.data.size() < 2000000;
      allow read, delete: if request.auth != null;
    }

    // 3. Reglas para vistas compartidas de solo lectura (Snapshot efímero)
    match /shared_views/{code} {
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.keys().hasAll(['accountName','totalBalance','createdAt'])
                    && request.resource.data.createdAt is int;
      // Lectura pública permitida para que el receptor pueda verla (incluso invitados)
      allow read: if true;
      // Permitir borrar o actualizar si eres el dueño O si el documento no tiene dueño (migración)
      allow delete, update: if request.auth != null
                            && (resource == null
                                || !('ownerId' in resource.data)
                                || resource.data.ownerId == request.auth.uid);

      // Reglas para los fragmentos del historial
      match /history_chunks/{chunkId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // 4. Reglas para solicitudes de acceso a infraestructura
    match /infrastructure_requests/{requestId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == "pending"
                    && request.resource.data.userChosenName is string
                    && request.resource.data.userChosenName.size() >= 3
                    && request.resource.data.userChosenName.size() <= 30
                    && request.resource.data.debugToken is string
                    && request.resource.data.debugToken.size() > 0;
      allow update: if false;
      allow delete: if false;
    }

    match /authorized_users/{userId} {
      // Solo el administrador puede listar todos los usuarios, pero el usuario puede leer su propio registro
      allow read: if request.auth != null && request.auth.uid == userId;
      // El usuario puede crear o actualizar su propio registro si tiene App Check válido
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // 5. Configuración de la aplicación (EmailJS, etc)
    match /config/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
