rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Reglas para datos privados de usuario (STWV Planner y Bóveda SuperWO)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Reglas para los códigos de transferencia (STWV Planner)
    match /transfer_codes/{code} {
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.data is string
                    && request.resource.data.data.size() < 2000000;
      allow read, delete: if request.auth != null;
    }

    // 3. Reglas para vistas compartidas de solo lectura (STWV Planner)
    match /shared_views/{code} {
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.accountName is string
                    && request.resource.data.accountName.size() >= 1
                    && request.resource.data.accountName.size() <= 120
                    && request.resource.data.totalBalance is int
                    && request.resource.data.createdAt is int
                    && request.resource.data.data is string
                    && request.resource.data.data.size() < 900000;
      allow read: if true;
      allow delete, update: if request.auth != null
                            && resource.data.ownerId == request.auth.uid
                            && request.resource.data.ownerId == request.auth.uid;

      match /history_chunks/{chunkId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // 4. Reglas para solicitudes de acceso a infraestructura (STWV Planner)
    match /infrastructure_requests/{requestId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == "pending"
                    && request.resource.data.userChosenName is string
                    && request.resource.data.userChosenName.size() >= 3
                    && request.resource.data.userChosenName.size() <= 30
                    && request.resource.data.debugToken is string
                    && request.resource.data.debugToken.size() > 0;
      allow update: if false;
      allow delete: if false;
    }

    // 5. Reglas para usuarios autorizados (STWV Planner)
    match /authorized_users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // 6. Configuración de la aplicación (STWV Planner)
    match /config/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}